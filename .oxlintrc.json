// oxlint for the webview (`src/`), the root config files and `lint/`. Every rule is an error:
// `denyWarnings` fails the run on a warning too, so nothing here is advisory.
{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "jsx-a11y", "import", "vitest"],
  "jsPlugins": ["./lint/oxlint-plugin.js"],
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
    "respectEslintDisableDirectives": false
  },
  "categories": { "correctness": "error", "suspicious": "error", "perf": "error" },
  "ignorePatterns": ["src/gql/**"],
  "rules": {
    // The categories' rules, fitted to this code.
    // The automatic JSX runtime imports React itself.
    "react/react-in-jsx-scope": "off",
    // Stylesheets and test setup are imported for their effect.
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "@testing-library/jest-dom/vitest"] }],
    // Names the host page and TanStack Router define.
    "no-underscore-dangle": ["error", { "allow": ["__KSTACK_HOST__", "__TSR_index", "__TSR_key"] }],
    // A mapped copy is how React state stays immutable.
    "oxc/no-map-spread": "off",
    // It reads `it` followed by a backtick in a JSX comment's prose as a test.
    "vitest/no-commented-out-tests": "off",
    // It reports a switch that lists every member of a union. `tsc` checks returns (`noImplicitReturns`).
    "typescript/consistent-return": "off",
    // `as` narrows after a check the types cannot follow: a DOM lookup, parsed JSON, a select's value.
    "typescript/no-unsafe-type-assertion": "off",
    // A component's own dialog or inline editor takes focus when it opens.
    "jsx-a11y/no-autofocus": ["error", { "ignoreNonDOM": true }],

    // Bugs the categories leave to `pedantic` and `restriction`.
    "array-callback-return": "error",
    "default-case-last": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-case-declarations": "error",
    "no-constructor-return": "error",
    "no-empty": "error",
    "no-loop-func": "error",
    "no-new-wrappers": "error",
    "no-promise-executor-return": "error",
    "no-prototype-builtins": "error",
    "no-script-url": "error",
    "no-self-compare": "error",
    "no-template-curly-in-string": "error",
    "radix": "error",
    "import/no-cycle": "error",
    "import/no-mutable-exports": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/only-throw-error": "error",
    "typescript/return-await": "error",

    // Control flow and mutation a reader can follow.
    "default-param-last": "error",
    "no-alert": "error",
    "no-else-return": ["error", { "allowElseIf": false }],
    "no-labels": "error",
    "no-lonely-if": "error",
    "no-multi-assign": "error",
    "no-nested-ternary": "error",
    "no-param-reassign": ["error", { "props": true, "ignorePropertyModificationsFor": ["acc"] }],
    "no-return-assign": ["error", "always"],
    "no-sequences": "error",
    "no-useless-return": "error",
    "one-var": ["error", "never"],
    // A DOM global that reads as a forgotten local: write `window.<name>`.
    "no-restricted-globals": [
      "error",
      "blur",
      "close",
      "event",
      "find",
      "focus",
      "history",
      "length",
      "location",
      "name",
      "open",
      "parent",
      "print",
      "scroll",
      "self",
      "status",
      "stop",
      "top"
    ],

    // Modern syntax over its older spelling.
    "arrow-body-style": "error",
    "no-useless-computed-key": "error",
    "no-var": "error",
    "object-shorthand": "error",
    "operator-assignment": "error",
    "prefer-arrow-callback": "error",
    "prefer-const": ["error", { "ignoreReadBeforeAssign": true }],
    "prefer-exponentiation-operator": "error",
    "prefer-object-has-own": "error",
    "prefer-object-spread": "error",
    "prefer-rest-params": "error",
    "prefer-spread": "error",
    "prefer-template": "error",
    "import/no-duplicates": "error",
    "typescript/array-type": "error",
    "typescript/consistent-indexed-object-style": "error",
    "typescript/dot-notation": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-inferrable-types": "error",
    "typescript/no-namespace": "error",
    "typescript/prefer-find": "error",
    "typescript/prefer-function-type": "error",
    "typescript/prefer-includes": "error",
    // `||` is how an empty string or a `false` falls through to the next operand.
    "typescript/prefer-nullish-coalescing": ["error", { "ignorePrimitives": { "string": true, "boolean": true } }],
    "typescript/prefer-string-starts-ends-with": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-structured-clone": "error",
    "unicorn/throw-new-error": "error",

    "react/button-has-type": "error",
    "react/jsx-boolean-value": "error",
    "react/jsx-curly-brace-presence": ["error", { "props": "never", "children": "never" }],
    "react/jsx-fragments": "error",
    "react/jsx-no-useless-fragment": ["error", { "allowExpressions": true }],
    "react/self-closing-comp": "error",

    // Type-aware rules beyond the categories. `correctness` brings the promise rules
    // (`no-floating-promises`, `await-thenable`).
    "typescript/no-deprecated": "error",
    // React drops a handler's promise; a rejection reaches `installGlobalErrorHandlers`.
    "typescript/no-misused-promises": ["error", { "checksVoidReturn": { "attributes": false } }],
    // A string is spread to count or spell its code points (`VisibleText`'s unit).
    "typescript/no-misused-spread": ["error", { "allow": ["string"] }],
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/prefer-reduce-type-parameter": "error",
    "typescript/related-getter-setter-pairs": "error",
    "typescript/restrict-plus-operands": "error",
    // A union's switch lists every member, so a new one fails here. Any other switch has a `default`.
    "typescript/switch-exhaustiveness-check": ["error", { "requireDefaultForNonUnion": true }],
    "typescript/use-unknown-in-catch-callback-variable": "error",

    // The React compiler's rules, as oxlint ports them. `correctness` turns on the rest of
    // `recommended-latest`'s set; `exhaustive-deps` is among them, an error because code here is
    // written to be correct without the compiler.
    "react/rules-of-hooks": "error",
    "react/unsupported-syntax": "error",
    // It reports a dependency an effect lists to rerun on, such as the location it closes a drawer on.
    "react/exhaustive-effect-dependencies": "off",

    "kstack/disable-needs-reason": "error",

    // `vi.fn()` infers its type from the implementation it is given.
    "vitest/require-mock-type-parameters": "off",
    // Tests assert through helpers named for what they check (`expectCodeText`).
    "vitest/expect-expect": ["error", { "assertFunctionNames": ["expect", "expect*"] }],
    // Vitest's `expect(value, message)`.
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    // `expect(mock.method)` and wonka's `{ unsubscribe }` reference methods that never read `this`.
    "typescript/unbound-method": "off",
    // The log viewer and the resize handles draw ARIA widgets no HTML element matches.
    "jsx-a11y/prefer-tag-over-role": "off",

    // Cluster data is attacker-controlled text, so nothing turns it into markup: no DOM HTML
    // sink, no template engine. `docs/security-model.md` lists this as enforced. `for…in` is
    // banned beside them: it walks the prototype chain.
    "kstack/no-restricted-syntax": [
      "error",
      { "selector": "ForInStatement", "message": "Use Object.{keys,values,entries} and iterate." },
      {
        "selector": "MemberExpression[property.name=/^(innerHTML|outerHTML|insertAdjacentHTML|createContextualFragment|write|writeln)$/]",
        "message": "Cluster data is attacker-controlled text; render it as text, never as HTML."
      },
      {
        "selector": "MemberExpression[computed=true][property.value=/^(innerHTML|outerHTML|insertAdjacentHTML|createContextualFragment|write|writeln)$/]",
        "message": "Cluster data is attacker-controlled text; render it as text, never as HTML."
      },
      { "selector": "JSXAttribute[name.name=/^srcdoc$/i]", "message": "No inline frames from data." },
      { "selector": "CallExpression[callee.name='eval']", "message": "No eval in the webview." },
      { "selector": "NewExpression[callee.name='Function']", "message": "No eval in the webview." },
      {
        "selector": "CallExpression[callee.name='template'], CallExpression[callee.property.name='template']",
        "message": "Cluster data is attacker-controlled text; read it with `src/lib/jsonpath.ts`, never a template engine."
      }
    ],
    "react/no-danger": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "handlebars",
              "handlebars/*",
              "mustache",
              "ejs",
              "nunjucks",
              "pug",
              "eta",
              "liquidjs",
              "dot",
              "dot/*",
              "lodash/template",
              "lodash.template"
            ],
            "message": "Cluster data is attacker-controlled text; read it with `src/lib/jsonpath.ts`, never a template engine."
          },
          {
            "group": [
              "@kubetail/ui/elements/input",
              "@kubetail/ui/elements/search-box",
              "@kubetail/ui/elements/textarea"
            ],
            "message": "Use '@/components/widgets/text-entry', which turns off the webview's suggestions."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "src/test-utils.tsx"],
      "rules": {
        // A test's provider renders once; a stable value would buy it nothing.
        "react/jsx-no-constructed-context-values": "off",
        "react/no-object-type-as-default-prop": "off",
        // A helper sits in the `describe` that uses it.
        "unicorn/consistent-function-scoping": "off",
        // A mock's calls and a dynamic import inside `vi.mock` are `any`.
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off"
      }
    }
  ]
}
