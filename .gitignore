# Sidecar build output (produced by `make sidecar`).
src-tauri/binaries/
# Kstack's own bwrap, its license and its source (produced by `make bwrap`).
src-tauri/linux/bwrap
src-tauri/linux/bubblewrap-*
# Kstack's own pasta, its licenses and its source (produced by `make pasta`).
src-tauri/linux/pasta
src-tauri/linux/passt-*
# Editor directories and files. The shared team config is re-included; anything
# else under .vscode/ is personal.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agents. Ignore the directory's contents rather than the directory itself, so
# the shared team config below can be re-included — a negation cannot resurrect
# a file whose parent directory is excluded. Personal settings
# (settings.local.json), worktrees, and lock files stay ignored.
CLAUDE.local.md
.claude/*
!.claude/settings.json

# Linux build outputs when developing inside the sandbox (see scripts note).
.sandbox-linux/

# custom
.worktrees

# Coverage output (make cover-js)
coverage/
