target
.env.local

# Sidecar build output (produced by `make sidecar`).
src-tauri/binaries/
# Kstack's own bwrap and its source (produced by `make bwrap`).
src-tauri/linux/bwrap
src-tauri/linux/bubblewrap-*.tar.xz
# Kstack's own pasta and its source (produced by `make pasta`).
src-tauri/linux/pasta
src-tauri/linux/passt-*.tar.xz
# Their source, in one archive (produced by `make embedded-sources`).
src-tauri/linux/embedded-sources.tar.gz
# Editor directories and files. The shared team config is re-included; anything
# else under .vscode/ is personal.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Agents. Ignore the directory's contents rather than the directory itself, so
# the shared team config below can be re-included — a negation cannot resurrect
# a file whose parent directory is excluded. Personal settings
# (settings.local.json), worktrees, lock files and personal skills stay ignored;
# each shared skill is re-included by name.
CLAUDE.local.md
.claude/*
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/release-notes/
!.claude/skills/release-version/

# Linux build outputs when developing inside the sandbox (see scripts note).
.sandbox-linux/

# custom
.worktrees

# Coverage output (make cover-js, make cover-go)
coverage/
sidecar/coverage.out
cli/coverage.out
